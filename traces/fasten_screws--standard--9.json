{"steps":1564,"frames":1565,"controlDt":0.04,"subtasks":["Insert and tighten each screw into the nut of the same color.","Use the left gripper to fasten the yellow nut on the yellow bolt and the right gripper to fasten the white nut on the white bolt. Keep each nut upright, seat it, and turn it clockwise to depth.","Tighten the seated pink nut one more stroke with the right gripper while the left gripper installs the loose yellow nut on its matching bolt.","Finish screwing the white nut clockwise onto the white bolt until the engagement is more than 9 mm. Withdraw the open left gripper from yellow and return it home. After white is fastened, fully open and return both arms to their initial poses.","Withdraw the open right gripper straight up from the white bolt. Fully open both grippers and return both arms to their episode-start poses."],"segments":[[0,16,"wall",0],[16,32,"wall",0],[32,48,"wall",0],[48,64,"wall",0],[64,80,"wall",0],[80,96,"wall",0],[96,112,"wall",0],[112,128,"wall",0],[128,144,"wall",0],[144,160,"wall",0],[160,176,"wall",0],[176,192,"wall",0],[192,208,"wall",0],[208,224,"wall",0],[224,240,"wall",0],[240,256,"wall",0],[256,272,"wall",0],[272,288,"wall",0],[288,304,"wall",0],[304,320,"wall",0],[320,336,"wall",0],[336,352,"wall",0],[352,368,"wall",0],[368,383,"wall",0],[383,386,"wall",0],[386,391,"edit",0],[391,407,"wall",0],[407,423,"wall",0],[423,439,"wall",0],[439,455,"wall",0],[455,471,"wall",0],[471,487,"wall",0],[487,503,"wall",0],[503,519,"wall",0],[519,535,"wall",0],[535,551,"wall",0],[551,567,"wall",0],[567,583,"wall",0],[583,599,"wall",0],[599,615,"wall",0],[615,631,"wall",0],[631,647,"wall",0],[647,663,"wall",0],[663,679,"wall",0],[679,695,"wall",0],[695,711,"wall",0],[711,727,"wall",0],[727,743,"wall",0],[743,767,"eef",1],[767,783,"wall",1],[783,806,"eef",2],[806,834,"eef",2],[834,855,"eef",2],[855,876,"eef",2],[876,888,"eef",2],[888,893,"edit",2],[893,898,"edit",2],[898,914,"wall",2],[914,919,"edit",2],[919,925,"wall",2],[925,935,"wall",2