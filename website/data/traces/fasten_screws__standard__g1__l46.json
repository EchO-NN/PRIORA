{"steps":1680,"controlDt":0.04,"subtasks":["Insert and tighten each screw into the nut of the same color.","Install and tighten the loose red nut from the right side onto the matching fixed red bolt on the left. Keep the nut upright and turn it down to the required depth.","Install the loose yellow nut on the central yellow bolt. Seat it upright and screw it down to the required depth.","Leave all three nuts on their matching bolts. Keep both grippers fully open, lift clear of the bolts, and return both arms to their initial poses.","With the left gripper, grasp the red nut on the left red bolt and screw it farther down clockwise while keeping it upright. Release the nut and return both arms home with open grippers.","Return both arms to their initial poses with both grippers fully open. Lift the left hand clear of the red nut before retracting it home."],"segments":[[0,16,"wall",0],[16,32,"wall",0],[32,48,"wall",0],[48,64,"wall",0],[64,80,"wall",0],[80,96,"wall",0],[96,112,"wall",0],[112,128,"wall",0],[128,144,"wall",0],[144,160,"wall",0],[160,176,"wall",0],[176,192,"wall",0],[192,208,"wall",0],[208,224,"wall",0],[224,240,"wall",0],[240,256,"wall",0],[256,272,"wall",0],[272,288,"wall",0],[288,304,"wall",0],[304,320,"wall",0],[320,336,"wall",0],[336,352,"wall",0],[352,368,"wall",0],[368,384,"wall",0],[384,400,"wall",0],[400,416,"wall",0],[416,419,"wall",0],[419,421,"wall",0],[421,426,"edit",0],[426,442,"wall",0],[442,458,"wall",0],[458,474,"wall",0],[474,490,"wall",0],[490,506,"wall",0],[506,521,"eef",1],[521,537,"wall",1],[537,553,"wall",1],[553,569,"wall",1],[569,585,"wall",1],[585,601,"wall",1],[601,617,"wall",1],[617,633,"wall",1],[633,649,"wall",1],[649,665,"wall",1],[665,681,"wall",1],[681,708,"eef",1],[708,724,"wall",1],[724,740,"wall",1],[740,756,"wall",1],[756,772,"wall",1],[772,788,"wall",1],[788,804,"wall",1],[804,820,"wall",1],[820,836,"wall",1],[836,852,"wall",1],[852,868,"wall",1],[868,884,"wall",1],[884,900,"wall",1],[900,916,"wall",1],[916,931,"eef",