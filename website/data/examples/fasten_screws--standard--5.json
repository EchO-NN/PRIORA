{"steps":1851,"controlDt":0.04,"frames":1852,"videoSha256":"8b6547a62c91929238381ab3f3eafb5a25971ba7675254c7987ddf1842c365b4","subtasks":["Insert and tighten each screw into the nut of the same color.","Fasten the pink pair: pick up the pink nut, place it over the upright pink screw, and turn the nut to tighten it.","Fasten the blue pair: pick up the blue nut, place it over the upright blue screw, and turn the nut to tighten it.","Leave the three seated fasteners on the table. Return both open grippers to their starting poses.","Tighten the already seated pink nut with the left gripper and the already seated blue nut with the right gripper at the same time. Regrip and turn clockwise until both screws reach the nut tops, then return home.","Use the right gripper to finish tightening the blue nut clockwise on its matching screw. Leave the seated pink and white nuts alone. Return both arms to their start poses after tightening.","Withdraw the open right gripper upward from the blue nut. Return both empty, open arms to their respective episode-start poses without touching the three assemblies."],"segments":[[0,16,"wall",0],[16,32,"wall",0],[32,48,"wall",0],[48,64,"wall",0],[64,80,"wall",0],[80,96,"wall",0],[96,112,"wall",0],[112,128,"wall",0],[128,144,"wall",0],[144,160,"wall",0],[160,176,"wall",0],[176,192,"wall",0],[192,208,"wall",0],[208,224,"wall",0],[224,240,"wall",0],[240,256,"wall",0],[256,272,"wall",0],[272,288,"wall",0],[288,304,"wall",0],[304,320,"wall",0],[320,336,"wall",0],[336,352,"wall",0],[352,368,"wall",0],[368,384,"wall",0],[384,400,"wall",0],[400,416,"wall",0],[416,432,"wall",0],[432,448,"wall",0],[448,464,"wall",0],[464,480,"wall",0],[480,496,"wall",0],[496,512,"wall",0],[512,528,"wall",0],[528,544,"wall",0],[544,560,"wall",0],[560,576,"wall",0],[576,592,"eef",1],[592,608,"wall",1],[608,632,"eef",1],[632,648,"wall",1],[648,649,"wall",1],[649,679,"eef",1],[679,695,"wall",1],[695,711,"wall",1],[711,727,"wall",1],[727,743,"wall",1],[743,759,"wall",1],[75